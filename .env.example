LEGAL_SESSION_KEY_BASE64=
LEGAL_SESSION_OWNER_ID=local-demo-user
# Optional; relative paths are resolved from the project root.
# The local web Demo auto-loads .env; explicitly set process variables take precedence.
LEGAL_SESSION_DATA_DIR=data/sessions
# Optional local web Demo port. The server always binds to 127.0.0.1.
LEGAL_DEMO_PORT=4173

# Agent inference: demo runs immediately; deepseek defaults to DeepSeek V4 Pro.
LEGAL_AGENT_PROVIDER=demo
LEGAL_AGENT_BASE_URL=
LEGAL_AGENT_MODEL=
LEGAL_AGENT_MODEL_ALIAS=legal-compliance-v0
# Runtime secret only. Never commit a real key.
LEGAL_AGENT_API_KEY=
LEGAL_AGENT_TIMEOUT_MS=30000
# Optional honest availability fallback for local demos: none or demo.
LEGAL_AGENT_FALLBACK=none

# Optional V1 SQLite data source. Keep the database itself outside Git.
# Relative paths are resolved from the project root. Access is forced read-only.
# Runtime mode: demo (default), sqlite, postgresql, or mysql.
LEGAL_V1_RUNTIME=demo
LEGAL_V1_SQLITE_PATH=

# PostgreSQL credentials are runtime-only. Use a dedicated SELECT-only account.
LEGAL_V1_PG_HOST=
LEGAL_V1_PG_PORT=5432
LEGAL_V1_PG_DATABASE=
LEGAL_V1_PG_USER=
LEGAL_V1_PG_PASSWORD=
# require (default) or disable for an isolated local acceptance database only.
LEGAL_V1_PG_TLS_MODE=require

# MySQL credentials are runtime-only. Use a dedicated SELECT-only account.
LEGAL_V1_MYSQL_HOST=
LEGAL_V1_MYSQL_PORT=3306
LEGAL_V1_MYSQL_DATABASE=
LEGAL_V1_MYSQL_USER=
LEGAL_V1_MYSQL_PASSWORD=
# require (default) or disable for an isolated local acceptance database only.
LEGAL_V1_MYSQL_TLS_MODE=require
