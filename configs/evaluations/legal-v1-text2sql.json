      "expected": { "code": "QUERY_TEMPLATE_NOT_SUPPORTED" }
    },
    {
      "id": "rejected-ambiguous-years",
      "category": "rejected",
      "schemaProfile": "full",
      "redactedText": "统计2022年、2023年和2024年未签劳动合同案件胜诉率和赔偿中位数。",
