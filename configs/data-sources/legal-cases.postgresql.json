{
  "schemaVersion": 1,
  "id": "network.legal_cases.postgresql",
  "engine": "postgresql",
  "schemaName": "public",
  "accessMode": "read-only",
  "connectionEnv": {
    "host": "LEGAL_V1_PG_HOST",
    "port": "LEGAL_V1_PG_PORT",
    "database": "LEGAL_V1_PG_DATABASE",
    "user": "LEGAL_V1_PG_USER",
    "password": "LEGAL_V1_PG_PASSWORD",
    "tlsMode": "LEGAL_V1_PG_TLS_MODE"
  },
  "allowedTables": [
    "labor_cases"
  ],
  "allowedColumns": [
    "year",
    "issue_type",
    "outcome",
    "compensation_amount"
  ],
  "timeoutMs": 15000,
  "maxRows": 500,
  "maxOutputBytes": 1048576
}
