  "runtimeWorkflow": {
    "id": "workflow.legal-professional-query",
    "version": "1.0.0",
    "initialState": "INITIAL",
    "terminalStates": ["COMPLETED", "FAILED"],
    "states": [
      { "id": "INITIAL", "capabilityRefs": {} },
      { "id": "LOAD_SCHEMA", "capabilityRefs": { "dataSourceProfileRef": { "id": "data-source-selector.active-v1-runtime", "version": "1.0.0" } } },
      { "id": "GENERATE_PLAN", "capabilityRefs": { "dataSourceProfileRef": { "id": "data-source-selector.active-v1-runtime", "version": "1.0.0" } } },
      { "id": "POLICY_CHECK", "capabilityRefs": { "dataSourceProfileRef": { "id": "data-source-selector.active-v1-runtime", "version": "1.0.0" } } },
      { "id": "HUMAN_REVIEW", "capabilityRefs": {} },
      { "id": "EXECUTE_SELECT", "capabilityRefs": { "dataSourceProfileRef": { "id": "data-source-selector.active-v1-runtime", "version": "1.0.0" } } },
      { "id": "EXECUTE_WRITE", "capabilityRefs": { "dataSourceProfileRef": { "id": "data-source-selector.active-v1-runtime", "version": "1.0.0" } } },
      { "id": "EXECUTE_SCRIPT", "capabilityRefs": { "workspaceProfileRef": { "id": "workspace.legal-v1-sandbox", "version": "1.0.0" }, "executionProfileRef": { "id": "execution-environment.lexpilot.scripts", "version": "1.0.0" }, "artifactProfileRef": { "id": "artifact-profile.lexpilot.v1-output", "version": "1.0.0" } } },
      { "id": "BUILD_ARTIFACT", "capabilityRefs": { "artifactProfileRef": { "id": "artifact-profile.lexpilot.v1-output", "version": "1.0.0" }, "outputContractRef": { "id": "output.legal-professional-query", "version": "1.0.0" } } },
      { "id": "APPEND_LOG", "capabilityRefs": {} },
      { "id": "COMPLETED", "capabilityRefs": { "artifactProfileRef": { "id": "artifact-profile.lexpilot.v1-output", "version": "1.0.0" }, "outputContractRef": { "id": "output.legal-professional-query", "version": "1.0.0" } } },
      { "id": "FAILED", "capabilityRefs": { "outputContractRef": { "id": "output.legal-professional-query", "version": "1.0.0" } } }
    ],
    "transitions": [
      { "from": "INITIAL", "to": "LOAD_SCHEMA", "route": "start" },
      { "from": "LOAD_SCHEMA", "to": "GENERATE_PLAN", "route": "schema-loaded" },
      { "from": "GENERATE_PLAN", "to": "POLICY_CHECK", "route": "plan-generated" },
      { "from": "POLICY_CHECK", "to": "EXECUTE_SELECT", "route": "read-only" },
      { "from": "POLICY_CHECK", "to": "HUMAN_REVIEW", "route": "write-or-script" },
      { "from": "POLICY_CHECK", "to": "APPEND_LOG", "route": "blocked" },
      { "from": "HUMAN_REVIEW", "to": "EXECUTE_WRITE", "route": "write-approved" },
      { "from": "HUMAN_REVIEW", "to": "EXECUTE_SCRIPT", "route": "script-approved" },
      { "from": "HUMAN_REVIEW", "to": "APPEND_LOG", "route": "rejected-or-timeout" },
      { "from": "EXECUTE_SELECT", "to": "BUILD_ARTIFACT", "route": "completed" },
      { "from": "EXECUTE_WRITE", "to": "BUILD_ARTIFACT", "route": "completed" },
      { "from": "EXECUTE_SCRIPT", "to": "BUILD_ARTIFACT", "route": "completed" },
      { "from": "BUILD_ARTIFACT", "to": "APPEND_LOG", "route": "artifact-stored" },
      { "from": "APPEND_LOG", "to": "COMPLETED", "route": "success-recorded" },
      { "from": "APPEND_LOG", "to": "FAILED", "route": "failure-recorded" }
    ]
  }
