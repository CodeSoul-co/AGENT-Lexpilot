{
  "name": "legal-compliance-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Hypha-based legal compliance agent V0 and V1 business project",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "demo:key": "node scripts/generate-session-key.cjs",
    "demo:v0": "node scripts/demo-v0.cjs",
    "demo:web": "node scripts/demo-web.cjs",
    "demo:web:deepseek": "powershell -NoProfile -File scripts/demo-web-deepseek.ps1",
    "audit:law-corpus": "node scripts/audit-law-corpus.cjs",
    "audit:law-coverage": "node scripts/audit-law-coverage.cjs",
    "audit:law-capabilities": "node scripts/audit-law-capabilities.cjs",
    "audit:law-versions": "node scripts/audit-law-versions.cjs",
    "audit:law-sources": "node scripts/audit-law-sources.cjs",
    "report:law-corpus": "node scripts/generate-law-corpus-report.cjs",
    "audit:sql:mysql": "node scripts/audit-sql-provider.cjs mysql",
    "audit:sql:postgresql": "node scripts/audit-sql-provider.cjs postgresql",
    "audit:text2sql": "node scripts/audit-text2sql-evaluation.cjs",
    "preflight:sandbox:docker": "node scripts/preflight-docker-sandbox.cjs",
    "audit:sandbox:docker": "node scripts/audit-docker-sandbox.cjs",
    "manage:execution-log": "node scripts/manage-execution-log.cjs",
    "verify:baseline": "node scripts/verify-baseline.cjs",
    "verify:domain": "node scripts/verify-domain-pack.cjs",
    "verify:replay": "node scripts/verify-replay-fixtures.cjs",
    "test": "node --test",
    "verify": "npm run verify:baseline && npm run verify:domain && npm run audit:text2sql && npm run verify:replay && npm test"
  },
  "dependencies": {
    "mysql2": "^3.23.2",
    "pg": "^8.22.0"
  }
}
