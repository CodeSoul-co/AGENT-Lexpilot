    {
      "id": "cn.civil-code.article-1064",
      "legalDomain": "marriage_family",
      "lawName": "中华人民共和国民法典",
      "articleNumber": "第一千零六十四条",
      "articleText": "夫妻双方共同签名或者夫妻一方事后追认等共同意思表示所负的债务，以及夫妻一方在婚姻关系存续期间以个人名义为家庭日常生活需要所负的债务，属于夫妻共同债务。\n\n夫妻一方在婚姻关系存续期间以个人名义超出家庭日常生活需要所负的债务，不属于夫妻共同债务；但是，债权人能够证明该债务用于夫妻共同生活、共同生产经营或者基于夫妻双方共同意思表示的除外。",
      "articleTextSha256": "7701aa9307622771f4e88f46fa1261ac6bf046e4674d52cce672a24d6ad4cb02",
      "publicationDate": "2020-05-28",
      "effectiveDate": "2021-01-01",
      "status": "effective",
      "topics": ["marital_common_debt", "household_needs"],
      "retrievalEnabled": false,
      "source": {
        "authority": "全国人大常委会办公厅国家法律法规数据库",
