    {
      "id": "cn.tax-collection-administration-law.article-25",
      "legalDomain": "taxation",
      "lawName": "中华人民共和国税收征收管理法",
      "articleNumber": "第二十五条",
      "articleText": "纳税人必须依照法律、行政法规规定或者税务机关依照法律、行政法规的规定确定的申报期限、申报内容如实办理纳税申报，报送纳税申报表、财务会计报表以及税务机关根据实际需要要求纳税人报送的其他纳税资料。\n\n扣缴义务人必须依照法律、行政法规规定或者税务机关依照法律、行政法规的规定确定的申报期限、申报内容如实报送代扣代缴、代收代缴税款报告表以及税务机关根据实际需要要求扣缴义务人报送的其他有关资料。",
      "articleTextSha256": "d12d9b38ec6e6b18d1282a1ebc42afa22a7e5aafb03271a9312932e393bc98b1",
      "publicationDate": "2015-04-24",
      "effectiveDate": "2015-04-24",
      "status": "effective",
      "topics": ["tax_declaration", "withholding_declaration"],
      "source": {
        "authority": "全国人大常委会办公厅国家法律法规数据库",
        "metadataUrl": "https://flk.npc.gov.cn/detail?id=2c909fdd678bf17901678bf78cff0785&title=%E4%B8%AD%E5%8D%8E%E4%BA%BA%E6%B0%91%E5%85%B1%E5%92%8C%E5%9B%BD%E7%A8%8E%E6%94%B6%E5%BE%81%E6%94%B6%E7%AE%A1%E7%90%86%E6%B3%95",
        "textAuthority": "国家市场监督管理总局",
        "textUrl": "https://www.samr.gov.cn/zw/zfxxgk/fdzdgknr/bgt/art/2023/art_1dbea81872cb4fda9ab3ccc45c627531.html"
      }
    },
    {
      "id": "cn.patent-law.article-11",
      "legalDomain": "intellectual_property",
      "lawName": "中华人民共和国专利法",
      "articleNumber": "第十一条",
      "articleText": "发明和实用新型专利权被授予后，除本法另有规定的以外，任何单位或者个人未经专利权人许可，都不得实施其专利，即不得为生产经营目的制造、使用、许诺销售、销售、进口其专利产品，或者使用其专利方法以及使用、许诺销售、销售、进口依照该专利方法直接获得的产品。\n\n外观设计专利权被授予后，任何单位或者个人未经专利权人许可，都不得实施其专利，即不得为生产经营目的制造、许诺销售、销售、进口其外观设计专利产品。",
      "articleTextSha256": "fade6d002e924b9c03a15adaeb4ac792eefdd18da919d23a5c7e47e9400e08d9",
      "publicationDate": "2020-10-17",
      "effectiveDate": "2021-06-01",
      "status": "effective",
      "topics": ["patent_implementation", "authorization"],
      "source": {
        "authority": "全国人大常委会办公厅国家法律法规数据库",
        "metadataUrl": "https://flk.npc.gov.cn/detail?fileId=&id=ff808081752b7d430175e4651cbd1547&title=%E4%B8%AD%E5%8D%8E%E4%BA%BA%E6%B0%91%E5%85%B1%E5%92%8C%E5%9B%BD%E4%B8%93%E5%88%A9%E6%B3%95&type=",
        "textAuthority": "国家知识产权局",
        "textUrl": "https://www.cnipa.gov.cn/art/2020/11/23/art_97_155167.html"
      }
    }
