      }
    },
    {
      "id": "cn.tax-collection-administration-law.article-32",
      "legalDomain": "taxation",
      "lawName": "中华人民共和国税收征收管理法",
      "articleNumber": "第三十二条",
      "articleText": "纳税人未按照规定期限缴纳税款的，扣缴义务人未按照规定期限解缴税款的，税务机关除责令限期缴纳外，从滞纳税款之日起，按日加收滞纳税款万分之五的滞纳金。",
      "articleTextSha256": "b2377c0b6b9b6c285f5a0272b66e210c6b948e105d6bb1f5a11665e7462d7790",
